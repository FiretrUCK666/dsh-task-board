{
  "name": "@firetruck666/dsh-task-board",
  "description": "Task board plugin for the DSH web GUI: a sidebar entry plus a multi-column kanban view with real execution through DSH sessions, schedules, session rules and auto-cruise automation. Board truth lives on the host and syncs to every device over SSE (the browser is an offline-first copy). Standalone plugin, no DSH source changes.",
  "version": "0.2.147",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FiretrUCK666/dsh-task-board.git"
  },
  "homepage": "https://github.com/FiretrUCK666/dsh-task-board#readme",
  "bugs": "https://github.com/FiretrUCK666/dsh-task-board/issues",
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-alpha.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "task-board",
    "kanban",
    "cordis"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-standalone.mjs . && node scripts/smoke-client.mjs . && node scripts/sync-toc.mjs README.md README.en.md --check && node scripts/verify-design-docs.mjs . && node scripts/verify-host-contracts.mjs . && node scripts/verify-host-contracts.mjs . --probe-removed && node scripts/verify-host-contracts.mjs . --probe-services",
    "smoke": "node scripts/smoke-client.mjs .",
    "toc": "node scripts/sync-toc.mjs README.md README.en.md",
    "design-docs": "node scripts/verify-design-docs.mjs .",
    "host-contracts": "node scripts/verify-host-contracts.mjs .",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test && pnpm verify"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-alpha.1",
    "react": "^18.2.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage-json": "^0.1.7-alpha.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.0",
    "lightningcss": "1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "license": "MIT"
}
